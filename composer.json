{
    "name": "balthild/php-cs-fixer-lsp",
    "description": "Language server for php-cs-fixer",
    "type": "project",
    "license": "MPL-2.0",
    "authors": [
        {
            "name": "Balthild",
            "email": "ibalthild@gmail.com"
        }
    ],
    "bin": "bin/php-cs-fixer-lsp",
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.2",
        "amphp/amp": "^3.0",
        "amphp/byte-stream": "^2.1",
        "amphp/process": "^2.0",
        "amphp/socket": "^2.4",
        "amphp/sync": "^2.0",
        "balthild/language-server": "dev-main#77baa34",
        "fidry/cpu-core-counter": "^1.3",
        "friendsofphp/php-cs-fixer": "3.94.2",
        "sebastian/diff": "^6.0",
        "symfony/console": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Balthild\\PhpCsFixerLsp\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Balthild\\PhpCsFixerLsp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
